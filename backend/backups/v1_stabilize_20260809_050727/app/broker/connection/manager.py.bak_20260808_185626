from __future__ import annotations

from typing import Any

from app.broker.core.router import broker_router
from app.broker.discovery.web_discovery import broker_web_discovery
from app.broker.security.credential_manager import credential_manager


class BrokerConnectionManager:
    """Central broker connection lifecycle."""

    def __init__(self):
        self._connections: dict[str, Any] = {}

    @staticmethod
    def _normalize(value: str) -> str:
        return str(value or "").strip().lower()

    async def discover(self, broker_name: str) -> dict:
        broker_name = str(broker_name or "").strip()

        adapter_cls = broker_router.resolve(broker_name)

        if adapter_cls is not None:
            credential_types = [
                "mt5",
                "mt4",
                "ctrader",
                "rest",
                "websocket",
                "fix",
            ]

            credential_matches = []

            for connection_type in credential_types:
                found = credential_manager.get_for_connection(
                    broker_name,
                    connection_type,
                )

                if found is not None:
                    credential_matches.append(connection_type)

            return {
                "success": True,
                "query": broker_name,
                "source": "registered_adapter",
                "profile": {
                    "name": broker_name,
                },
                "adapter": adapter_cls.__name__,
                "ready_for_connection": True,
                "credentials_required": True,
                "credentials_found": bool(credential_matches),
                "credential_connection_types": credential_matches,
            }

        return await broker_web_discovery.discover(broker_name)

    async def connect(
        self,
        broker_name: str,
        connection_type: str = "mt5",
        credentials: dict | None = None,
        credential_id: str | None = None,
        config: dict | None = None,
    ) -> dict:
        broker_name = str(broker_name or "").strip()
        connection_type = str(
            connection_type or ""
        ).strip().lower()

        adapter_cls = broker_router.resolve(broker_name)

        if adapter_cls is None:
            discovery = await self.discover(broker_name)

            return {
                "connected": False,
                "status": "BROKER_NOT_FOUND",
                "broker": broker_name,
                "discovery": discovery,
            }

        if credentials is not None and credential_id is not None:
            raise ValueError(
                "Provide credentials or credential_id, not both"
            )

        if credentials is not None:
            stored = credential_manager.store(
                broker=broker_name,
                connection_type=connection_type,
                credentials=credentials,
            )
            credential_id = stored["credential_id"]

        if credential_id is not None:
            connection_credentials = credential_manager.get(
                credential_id
            )
        else:
            connection_credentials = (
                credential_manager.get_for_connection(
                    broker_name,
                    connection_type,
                )
            )

        if connection_credentials is None:
            return {
                "connected": False,
                "status": "CREDENTIALS_REQUIRED",
                "broker": broker_name,
                "adapter": adapter_cls.__name__,
                "connection_type": connection_type,
                "credential_id": credential_id,
            }

        adapter = adapter_cls()

        try:
            result = await adapter.connect(
                credentials=connection_credentials,
                config=config,
            )
        except Exception as exc:
            return {
                "connected": False,
                "status": "CONNECTION_ERROR",
                "broker": broker_name,
                "adapter": adapter_cls.__name__,
                "connection_type": connection_type,
                "error": type(exc).__name__,
            }

        connected = (
            isinstance(result, dict)
            and result.get("status") in {
                "CONNECTED",
                "READY",
            }
        )

        if not connected:
            return {
                "connected": False,
                "status": (
                    result.get("status", "CONNECTION_FAILED")
                    if isinstance(result, dict)
                    else "CONNECTION_FAILED"
                ),
                "broker": broker_name,
                "adapter": adapter_cls.__name__,
                "connection_type": connection_type,
                "credential_id": credential_id,
            }

        key = self._normalize(broker_name)

        self._connections[key] = {
            "adapter": adapter,
            "broker": broker_name,
            "connection_type": connection_type,
            "credential_id": credential_id,
        }

        return {
            "connected": True,
            "status": (
                result.get("status", "CONNECTED")
                if isinstance(result, dict)
                else "CONNECTED"
            ),
            "broker": broker_name,
            "adapter": adapter_cls.__name__,
            "connection_type": connection_type,
            "credential_id": credential_id,
        }

    async def disconnect(self, broker_name: str) -> dict:
        key = self._normalize(broker_name)
        connection = self._connections.get(key)

        if connection is None:
            return {
                "disconnected": False,
                "status": "NOT_CONNECTED",
                "broker": broker_name,
            }

        adapter = connection["adapter"]

        try:
            result = await adapter.disconnect()
        except Exception as exc:
            return {
                "disconnected": False,
                "status": "DISCONNECT_ERROR",
                "broker": broker_name,
                "error": type(exc).__name__,
            }
        finally:
            self._connections.pop(key, None)

        return {
            "disconnected": True,
            "status": (
                result.get("status", "DISCONNECTED")
                if isinstance(result, dict)
                else "DISCONNECTED"
            ),
            "broker": broker_name,
        }

    def connected_brokers(self) -> list[str]:
        return sorted(self._connections.keys())

    async def health_check(self, broker_name: str) -> dict:
        key = self._normalize(broker_name)
        connection = self._connections.get(key)

        if connection is None:
            return {
                "healthy": False,
                "status": "NOT_CONNECTED",
                "broker": broker_name,
            }

        adapter = connection["adapter"]

        try:
            result = await adapter.health_check()

            return {
                "healthy": bool(
                    result.get("healthy", False)
                ),
                "status": result.get("status", "UNKNOWN"),
                "broker": broker_name,
                "adapter": type(adapter).__name__,
            }

        except Exception as exc:
            return {
                "healthy": False,
                "status": "ERROR",
                "broker": broker_name,
                "error": type(exc).__name__,
            }


broker_connection_manager = BrokerConnectionManager()
