from app.security.auth.brute_force import (
    is_account_locked,
    register_failed_login,
    reset_failed_logins,
)

router = APIRouter(prefix="/auth", tags=["auth"])


def get_session_manager(db: AsyncSession) -> AuthSessionManager:
    return AuthSessionManager(AuthSessionRepository(db))


@router.post(
    "/register",
    response_model=UserResponse,
    status_code=status.HTTP_201_CREATED,
)
async def register(
    data: RegisterRequest,
    db: AsyncSession = Depends(get_db),
):
    service = UserService(db)

    try:
        user = await service.create(
            email=str(data.email),
            username=data.username,
            password=data.password,
            language=normalize_language(data.language),
        )

        await db.commit()
        return user

    except ValueError as exc:
        await db.rollback()

        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail=i18n.translate(
                "auth.email_exists"
                if "email" in str(exc).lower()
                else "auth.username_exists"
            ),
        )


@router.post("/login", response_model=TokenResponse)
async def login(
    data: LoginRequest,
    request: Request,
    db: AsyncSession = Depends(get_db),
):
    service = UserService(db)

    client_ip = (
        request.client.host
        if request.client
        else "unknown"
    )

    rate_key = f"login:{client_ip}:{data.username.lower()}"

    if not auth_rate_limiter.check(
        rate_key,
        limit=5,
        window_seconds=60,
    ):
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Too many authentication attempts",
        )

    i18n.set_language(
        normalize_language(data.language)
    )

    user = await service.authenticate(
        username=data.username,
        password=data.password,
    )

    if user and is_account_locked(user):
        raise HTTPException(
            status_code=status.HTTP_423_LOCKED,
            detail="Account temporarily locked",
        )

    if not user:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail=i18n.translate(
                "auth.invalid_credentials"
            ),
        )

    access_token = create_access_token(
        user_id=user.id,
        username=user.username,
        language=user.language,
    )

    manager = get_session_manager(db)

    refresh_token, _ = await manager.create_session(
        user_id=user.id,
        device_name=data.device_name,
        ip_address=(
            request.client.host
            if request.client
            else None
        ),
        user_agent=request.headers.get("user-agent"),
    )

    await db.commit()

    return TokenResponse(
        access_token=access_token,
        refresh_token=refresh_token,
        token_type="bearer",
        user=user,
    )


@router.post("/refresh", response_model=TokenResponse)
async def refresh(
    data: RefreshRequest,
    request: Request,
    db: AsyncSession = Depends(get_db),
):
    manager = get_session_manager(db)

    try:
        result = await manager.rotate(
            data.refresh_token,
            ip_address=(
                request.client.host
                if request.client
                else None
            ),
            user_agent=request.headers.get("user-agent"),
        )

    except RefreshTokenReplayError:
        await db.commit()

        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Refresh token reuse detected",
        )

    if not result:
        await db.rollback()

        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail=i18n.translate(
                "auth.invalid_or_expired_session"
            ),
        )

    new_refresh_token, session, replay_detected = result

    if replay_detected:
        await db.commit()
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Refresh token reuse detected",
        )

    user = await UserService(db).get_by_id(
        session.user_id
    )

    if not user:
        await db.rollback()

        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail=i18n.translate(
                "auth.user_not_found"
            ),
        )

    access_token = create_access_token(
        user_id=user.id,
        username=user.username,
        language=user.language,
    )

    i18n.set_language(
        normalize_language(user.language)
    )

    await db.commit()

    return TokenResponse(
        access_token=access_token,
        refresh_token=new_refresh_token,
        token_type="bearer",
        user=user,
    )


@router.post("/logout")
async def logout(
    data: LogoutRequest,
    db: AsyncSession = Depends(get_db),
):
    manager = get_session_manager(db)

    await manager.revoke(
        data.refresh_token
    )

    await db.commit()

    return {"success": True}


@router.post("/logout-all")
async def logout_all(
    current_user=Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
):
    repository = AuthSessionRepository(db)

    await repository.revoke_all_for_user(
        current_user.id
    )

    await db.commit()

    return {"success": True}


