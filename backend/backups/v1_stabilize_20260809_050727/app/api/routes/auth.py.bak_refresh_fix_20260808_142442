    LoginRequest,
    RegisterRequest,
    RefreshRequest,
    LogoutRequest,
    TokenResponse,
    UserResponse,
    SessionResponse,
    ForgotPasswordRequest,
    ResetPasswordRequest,
)
from app.security.auth.jwt import create_access_token
from app.security.auth.dependencies import get_current_user
from app.security.auth.session_manager import (
    AuthSessionManager,
    RefreshTokenReplayError,
)
from app.repositories.auth_session_repository import AuthSessionRepository
from app.services.user_service import UserService
from app.i18n.manager import i18n, normalize_language
