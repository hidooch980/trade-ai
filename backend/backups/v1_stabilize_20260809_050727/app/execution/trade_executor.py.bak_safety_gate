from app.market.bridge.mt5_bridge import mt5_bridge
from app.execution.position_manager import position_manager
from app.execution.position_store import position_store
from app.risk.risk_manager import risk_manager
from app.risk.dynamic_sl_tp_engine import dynamic_sl_tp_engine
from app.ai.journal.trade_journal import trade_journal


class TradeExecutor:

    def __init__(self):
        self.mt5 = mt5_bridge


    async def execute(
        self,
        symbol,
        signal,
        risk
    ):

        print("EXEC_SIGNAL_DEBUG:", signal)

        if not isinstance(symbol, str) or not symbol.strip():
            return {
                "executed": False,
                "reason": "INVALID_SYMBOL"
            }

        if not isinstance(signal, dict):
            return {
                "executed": False,
                "reason": "NO_TRADE_SIGNAL"
            }

        if signal.get("decision") not in [
            "BUY",
            "SELL"
        ]:
            return {
                "executed": False,
                "reason": "NO_TRADE_SIGNAL"
            }


        if not isinstance(risk, dict):
            return {
                "executed": False,
                "reason": "INVALID_RISK"
            }

        if not risk.get("approved"):
            return {
                "executed": False,
                "reason": "RISK_REJECTED"
            }

        volume = risk.get("volume", 0)

        if (
            not isinstance(volume, (int, float))
            or isinstance(volume, bool)
            or not __import__("math").isfinite(volume)
        ):
            return {
                "executed": False,
                "reason": "VOLUME_INVALID"
            }

        if volume <= 0:
            return {
                "executed": False,
                "reason": "VOLUME_ZERO_BLOCK"
            }

        stop_loss = risk.get("stop_loss")
        take_profit = risk.get("take_profit")

        if stop_loss is None or stop_loss == 0:
            return {
                "executed": False,
                "reason": "MISSING_STOP_LOSS"
            }

        if take_profit is None or take_profit == 0:
            return {
                "executed": False,
                "reason": "MISSING_TAKE_PROFIT"
            }

        if (
            not isinstance(stop_loss, (int, float))
            or isinstance(stop_loss, bool)
            or not __import__("math").isfinite(stop_loss)
            or stop_loss <= 0
        ):
            return {
                "executed": False,
                "reason": "INVALID_STOP_LOSS"
            }

        if (
            not isinstance(take_profit, (int, float))
            or isinstance(take_profit, bool)
            or not __import__("math").isfinite(take_profit)
            or take_profit <= 0
        ):
            return {
                "executed": False,
                "reason": "INVALID_TAKE_PROFIT"
            }

        entry_price = risk.get("entry_price", 0)

        if (
            not isinstance(entry_price, (int, float))
            or isinstance(entry_price, bool)
            or not __import__("math").isfinite(entry_price)
            or entry_price <= 0
        ):
            return {
                "executed": False,
                "reason": "INVALID_ENTRY_PRICE"
            }

        if signal["decision"] == "BUY":
            if stop_loss >= entry_price:
                return {
                    "executed": False,
                    "reason": "INVALID_SL_RELATION"
                }

            if take_profit <= entry_price:
                return {
                    "executed": False,
                    "reason": "INVALID_TP_RELATION"
                }

        elif signal["decision"] == "SELL":
            if stop_loss <= entry_price:
                return {
                    "executed": False,
                    "reason": "INVALID_SL_RELATION"
                }

            if take_profit >= entry_price:
                return {
                    "executed": False,
                    "reason": "INVALID_TP_RELATION"
                }

        risk_check = risk_manager.check(
            position_store.get_all(),
            risk["volume"],
            entry_price
        )

        if not risk_check["approved"]:
            return {
                "executed": False,
                "reason": risk_check["reason"]
            }


        account_positions = position_store.get_all()


        position_check = position_manager.can_open(
            symbol,
            signal["decision"],
            account_positions
        )


        if not position_check["allowed"]:
            return {
                "executed": False,
                "reason": position_check["reason"]
            }


        entry_price = risk.get("entry_price", 0)

        dynamic_levels = dynamic_sl_tp_engine.calculate(
            side=signal["decision"],
            entry=entry_price,
            atr=risk.get("atr", 0),
            symbol=symbol
        )

        if not dynamic_levels.get("approved"):
            return {
                "executed": False,
                "reason": dynamic_levels.get("reason")
            }

        order = {
            "symbol": symbol,
            "side": signal["decision"],
            "volume": risk["volume"],
            "price": entry_price,
            "stop_loss": dynamic_levels["stop_loss"],
            "take_profit": dynamic_levels["take_profit"]
        }


        mt5_result = await self.mt5.send_order(order)

        if not mt5_result.get("sent"):
            return {
                "executed": False,
                "reason": mt5_result.get("reason", "MT5_ORDER_FAILED"),
                "mt5": mt5_result
            }

        trade_journal.add("OPEN_ORDER", order)

        position_store.add({
            "ticket": mt5_result.get("ticket"),
            "symbol": symbol,
            "side": signal["decision"],
            "volume": risk["volume"],
            "entry_price": order["price"],
            "current_price": order["price"],
            "pnl": 0.0,
            "stop_loss": dynamic_levels["stop_loss"],
            "take_profit": dynamic_levels["take_profit"],
            "status": "OPEN"
        })


        return {
            "executed": True,
            "order": {
                **order,
                "status": "PENDING_MT5",
                "mt5": mt5_result
            }
        }
