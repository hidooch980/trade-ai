from __future__ import annotations

from app.broker.core.router import broker_router
from app.broker.discovery.web_discovery import broker_web_discovery


class BrokerConnectionManager:
    """
    Universal broker connection lifecycle.

    Flow:
        broker name
          -> discovery
          -> adapter resolution
          -> credentials/config
          -> connect
          -> health check

    Credentials are passed through memory only and are never discovered,
    logged, persisted, or returned by this manager.
    """

    def __init__(self):
        self._connections: dict[str, object] = {}

    async def discover(self, broker_name: str) -> dict:
        return await broker_web_discovery.discover(broker_name)

    def _resolve_adapter(self, broker_name: str, connection_type: str | None = None):
        if connection_type:
            adapter = broker_router.resolve(connection_type)
            if adapter:
                return adapter

        return broker_router.resolve(broker_name)

    async def connect(
        self,
        broker_name: str,
        credentials: dict | None = None,
        config: dict | None = None,
        connection_type: str | None = None,
    ) -> dict:
        discovery = await self.discover(broker_name)

        if not discovery.get("success"):
            return {
                "connected": False,
                "status": "BROKER_NOT_FOUND",
                "broker": broker_name,
                "discovery": discovery,
            }

        adapter_cls = self._resolve_adapter(
            broker_name,
            connection_type,
        )

        if adapter_cls is None:
            return {
                "connected": False,
                "status": "ADAPTER_NOT_AVAILABLE",
                "broker": broker_name,
                "discovery": discovery,
            }

        adapter = adapter_cls()

        try:
            result = await adapter.connect(
                credentials=credentials,
                config=config,
            )

            key = str(broker_name).strip().lower()
            self._connections[key] = adapter

            return {
                "connected": True,
                "status": (
                    result.get("status", "CONNECTED")
                    if isinstance(result, dict)
                    else "CONNECTED"
                ),
                "broker": broker_name,
                "adapter": adapter_cls.__name__,
                "connection_type": connection_type,
                "result": result,
            }

        except Exception as exc:
            return {
                "connected": False,
                "status": "CONNECTION_ERROR",
                "broker": broker_name,
                "adapter": adapter_cls.__name__,
                "error": type(exc).__name__,
                "message": str(exc),
            }

    def get_connection(self, broker_name: str):
        key = str(broker_name).strip().lower()
        return self._connections.get(key)

    def connected_brokers(self) -> list[str]:
        return sorted(self._connections.keys())

    async def health_check(self, broker_name: str) -> dict:
        adapter = self.get_connection(broker_name)

        if adapter is None:
            return {
                "healthy": False,
                "status": "NOT_CONNECTED",
                "broker": broker_name,
            }

        try:
            result = await adapter.health_check()

            return {
                "broker": broker_name,
                **result,
            }

        except Exception as exc:
            return {
                "healthy": False,
                "status": "ERROR",
                "broker": broker_name,
                "error": type(exc).__name__,
                "message": str(exc),
            }

    async def disconnect(self, broker_name: str) -> dict:
        key = str(broker_name).strip().lower()
        adapter = self._connections.get(key)

        if adapter is None:
            return {
                "disconnected": True,
                "status": "NOT_CONNECTED",
                "broker": broker_name,
            }

        try:
            result = await adapter.disconnect()
        finally:
            self._connections.pop(key, None)

        return {
            "disconnected": True,
            "broker": broker_name,
            "result": result,
        }


broker_connection_manager = BrokerConnectionManager()
