from app.market.regime.market_regime_ai import market_regime_ai
from app.decision.final_decision_engine import FinalDecisionEngine
from app.decision.master_ai_core import MasterAICore
from app.risk.risk_governor import RiskGovernor
from app.risk.adaptive.adaptive_risk_engine import adaptive_risk_engine
from app.ai.memory.strategy_memory import strategy_memory
from app.broker.risk.account_monitor import AccountRiskMonitor
from app.chart_ai.live.smart_money_live import SmartMoneyLive
from app.smart_money.core.smart_money_core import smart_money_core
from app.market_data.candle.candle_builder import CandleBuilder
from app.market_data.store.market_store import market_store
from app.execution.trade_executor import TradeExecutor
from app.ai.learning.trade_result_pipeline import trade_result_pipeline
from app.market.bridge.mt5_bridge import mt5_bridge

from app.chart_ai.structure.market_structure import MarketStructureEngine
from app.chart_ai.indicators.indicator_engine import indicator_engine
from app.indicators.bridge.indicator_bridge import indicator_bridge
from app.chart_ai.liquidity.liquidity_engine import LiquidityEngine
from app.chart_ai.liquidity.sweep_detector import SweepDetector
from app.chart_ai.smart_money.order_block.order_block_engine import OrderBlockEngine
from app.chart_ai.smart_money.fvg.fvg_engine import FVGEngine


class SignalPipeline:

    def __init__(self):

        self.decision_engine = FinalDecisionEngine()
        self.master_ai = MasterAICore()
        self.risk = RiskGovernor()
        self.account_monitor = AccountRiskMonitor()
        self.smart_money = SmartMoneyLive()
        self.smart_money_core = smart_money_core
        self.candle_builder = CandleBuilder()
        self.candle_history = market_store.history
        self.executor = TradeExecutor()

        self.structure = MarketStructureEngine()
        self.liquidity = LiquidityEngine()
        self.sweep_detector = SweepDetector()
        self.order_block = OrderBlockEngine()
        self.fvg = FVGEngine()


    async def generate(
        self,
        symbol,
        price
    ):

        candles = market_store.get(symbol).copy()

        if len(candles) < 3:
            candles = [
                {
                    "open": price-10,
                    "high": price+10,
                    "low": price-10,
                    "close": price
                }
            ]

        structure = self.structure.analyze(
            candles
        )

        indicator_result = indicator_engine.analyze(
            candles
        )

        advanced_indicator = indicator_bridge.analyze(candles)


        liquidity = self.liquidity.analyze(
            candles
        )


        sweep = self.sweep_detector.analyze(candles)

        order_block = self.order_block.analyze(
            candles
        )


        fvg = self.fvg.analyze(
            candles
        )


        smart_money = self.smart_money_core.analyze(
            symbol,
            candles,
            structure,
            liquidity,
            order_block,
            fvg,
            sweep
        )


        account = await mt5_bridge.get_account()
        positions = await mt5_bridge.get_positions()

        account_status = self.account_monitor.analyze(
            account
        )

        account_status["positions"] = positions

        strategy = strategy_memory.get(
            symbol,
            "M1"
        )

        performance = (
            strategy.get("performance", {})
            if strategy
            else {}
        )

        adaptive_risk = adaptive_risk_engine.calculate(
            performance
        )

        from app.risk.dynamic_sl_tp_engine import dynamic_sl_tp_engine

        sl_tp = dynamic_sl_tp_engine.calculate(
            smart_money.get("decision", "BUY"),
            price,
            indicator_result.get("atr", 0) or adaptive_risk.get("atr", 0.002),
            symbol=symbol
        )

        dynamic_stop_loss = sl_tp.get("stop_loss", price - 10)
        dynamic_take_profit = sl_tp.get("take_profit")

        risk_result = self.risk.calculate_position_size(
            capital=account["balance"],
            risk_percent=adaptive_risk["risk_percent"],
            entry_price=price,
            stop_loss=dynamic_stop_loss,
            symbol=symbol
        )

        if sl_tp.get("approved"):
            risk_result["stop_loss"] = dynamic_stop_loss
            risk_result["take_profit"] = dynamic_take_profit

        drawdown_check = self.risk.validate_drawdown(
            account_status.get("drawdown", 0)
        )

        ai_result = self.master_ai.decide(symbol)

        indicator_signal = {
            "trend": structure.get("trend"),
            "structure": structure.get("structure"),
            "decision": advanced_indicator.get("decision"),
            "score": advanced_indicator.get("score", 0),
            "votes": advanced_indicator.get("votes", [])
        }

        result = self.decision_engine.decide(
            indicator_signal,
            {"decision": ai_result.get("action")},
            {"approved": drawdown_check.get("approved", True)},
            smart_money
        )


        return {

            "symbol": symbol,

            "price": price,

            "structure": structure,

            "liquidity": liquidity,
            "sweep": sweep,

            "order_block": order_block,

            "fvg": fvg,

            "risk": {
                "position": risk_result,
                "account": account_status,
                "drawdown": drawdown_check
            },
            "smart_money": smart_money,
            "execution": await self.executor.execute(
                symbol,
                result,
                risk_result
            ),
            "decision": result

        }
