from app.learning.market_memory import market_memory


class FinalDecisionEngine:

    def decide(
        self,
        indicator_signal,
        ai_signal,
        risk,
        smart_money
    ):

        score = 0
        reasons = []

        # Smart Money primary weight
        smart = smart_money.get("decision")

        if smart == "BUY":
            score += 50
            reasons.append("SMART_MONEY_BUY")

        elif smart == "SELL":
            score -= 50
            reasons.append("SMART_MONEY_SELL")


        # Market structure confirmation
        structure = indicator_signal.get("trend")

        if structure == "BULLISH":
            score += 20
            reasons.append("BULLISH_STRUCTURE")

        elif structure == "BEARISH":
            score -= 20
            reasons.append("BEARISH_STRUCTURE")


        # AI secondary confirmation
        ai_decision = ai_signal.get("decision")

        if ai_decision == "BUY":
            score += 10
            reasons.append("AI_CONFIRM_BUY")

        elif ai_decision == "SELL":
            score -= 10
            reasons.append("AI_CONFIRM_SELL")


        # Risk gate
        if risk.get("approved"):
            reasons.append("RISK_OK")
        else:
            score = 0
            reasons.append("RISK_BLOCK")


        decision = "WAIT"

        if score >= 60:
            decision = "BUY"

        elif score <= -60:
            decision = "SELL"


        market_memory.add({
            "decision": decision,
            "score": score,
            "reasons": reasons,
            "indicator": indicator_signal,
            "ai": ai_signal,
            "risk": risk,
            "smart_money": smart_money
        })


        return {
            "engine": "FINAL_DECISION",
            "decision": decision,
            "score": score,
            "reasons": reasons
        }
